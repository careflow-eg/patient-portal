# CareFlow Patient Portal — required environment variables.
# Copy to .env.local for development. All are NEXT_PUBLIC_* and are inlined into
# the client bundle at build time — never put a secret here.

# API Gateway (workflow-orchestrator) base URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base for the live voice intake session.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
